# ============================================================
# PLANTILLA de Variables de Entorno
# SPA Management System
# ============================================================
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# Base de Datos MySQL
# Devuelve DB_HOST=mysql cuando se usa el MySQL de docker-compose
# ----------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=spa_user
DB_PASSWORD=CAMBIAR_ESTA_CONTRASEÑA
DB_NAME=spa_management
# Credenciales del contenedor MySQL (solo docker-compose)
MYSQL_ROOT_PASSWORD=CONTRASEÑA_ROOT_SEGURA

# ----------------------------------------------------------
# JWT - Autenticación
# ----------------------------------------------------------
# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GENERAR_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# Aplicación
# ----------------------------------------------------------
APP_NAME=SPA Management System
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
ENVIRONMENT=production
# Habilita /docs, /redoc y /openapi.json.
# En producción están deshabilitados salvo ENABLE_DOCS=true
ENABLE_DOCS=false

# ----------------------------------------------------------
# CORS - Orígenes permitidos (separados por coma)
# ----------------------------------------------------------
CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ----------------------------------------------------------
# Tenant por defecto
# ----------------------------------------------------------
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CONTRASEÑA_REDIS_SEGURA

# ----------------------------------------------------------
# Apple Wallet Web Service (actualización dinámica de pases)
# ----------------------------------------------------------
# URL base pública que Apple usará para /v1/devices/..., /v1/passes/...
# y /v1/log (sin barra final). nginx DEBE proxear /v1/* al backend
# (ver frontend/nginx.conf). El dominio debe resolver a HTTPS público.
WALLET_WEB_SERVICE_BASE_URL=https://estetica.tienderu.com
# APNs: se activa solo si APNS_ENABLED=true o si se configuran las tres
# credenciales .p8 (auto-detección). 'passkit-update' NO es un push-type
# válido; se envía 'background' con prioridad 5 (obligatorio para pases).
APNS_ENABLED=false
APNS_SANDBOX=false
# APNs Key del developer account: kid es el identificador de la llave
# (X-0ABC...), team/iss es tu Team ID; P8_PATH es la ruta del AuthKey_*.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8_PATH=
# Topic del push = passTypeIdentifier del pase (NUNCA el bundle del app)
APNS_TOPIC=pass.com.tuuspa.fidelidad
APNS_PUSH_TYPE=background
APNS_PRIORITY=5
APNS_EXPIRATION=86400

# ----------------------------------------------------------
# Firma .pkpass (PKCS#7/CMS) - OPCIONAL
# Apple valida la firma en producción. Sin estos certificados el pase se
# genera SIN firmar (warning en logs). Rutas dentro del contenedor backend:
#   PASS_SIGNER_CERT_PATH -> certificado del Pass Type ID (PEM)
#   PASS_SIGNER_KEY_PATH  -> clave privada de ese certificado (PEM)
#   PASS_WWDR_CERT_PATH   -> certificado intermedio WWDR de Apple (PEM)
# Móntalo como secrets/docker volume; NUNCA lo dejes en git.
#PASS_SIGNER_CERT_PATH=/run/secrets/pass_sign_cert.pem
#PASS_SIGNER_KEY_PATH=/run/secrets/pass_sign_key.pem
#PASS_WWDR_CERT_PATH=/run/secrets/WWDR.pem

# ----------------------------------------------------------
# Google Wallet (LoyaltyClass / LoyaltyObject - API REAL)
# ----------------------------------------------------------
# Integración oficial con Google Wallet API v1. Mientras no configures
# estas variables, el sistema funciona igual (Apple Wallet .pkpass) y
# NO se hace ninguna llamada a Google. El botón "Añadir a Google Wallet"
# mostrará el aviso de que no está habilitado.
#
# Pasos para obtener los valores (ver docs/google-wallet.md):
#   1. Google Cloud Console -> habilita "Google Wallet API".
#   2. Crea una cuenta de servicio y descarga su .json de credenciales.
#   3. Google Wallet API -> Issuer account -> obtén tu issuer_id.
#   4. Autoriza el issuer (demo/producción) desde la consola de Wallet.
#
# GOOGLE_WALLET_ENABLED = true  (¡actívalo SOLO con credenciales reales!)
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio: pega el "private_key" del .json
# (PEM con saltos de línea, entre comillas) o su versión base64.
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_PRIVATE_KEY_ID=
GOOGLE_WALLET_PROJECT_ID=
# Opcional: ruta (dentro del contenedor) al .json de la cuenta de servicio
# en vez de meter la clave en el .env. NUNCA dejes el .json en git.
# Ruta (dentro del contenedor) al .json de la cuenta de servicio, montado
# como volumen de SOLO LECTURA (Application Default Credentials). Es la vía
# preferida; si no se monta, usa GOOGLE_WALLET_SERVICE_ACCOUNT_FILE o pega
# la clave en GOOGLE_WALLET_PRIVATE_KEY.
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials/service-account.json
#GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=/run/secrets/google_wallet_service_account.json
GOOGLE_WALLET_SCOPE=https://www.googleapis.com/auth/wallet_object.issuer
# Dominio permitido para el botón (claim origins). Vacío = host actual.
GOOGLE_WALLET_ORIGIN=estetica.tienderu.com

# ----------------------------------------------------------
# Asistente IA (FreeLLMAPI - proxy OpenAI-compatible)
# ----------------------------------------------------------
# Asistente digital del SPA: consultas, recomendaciones y programa de
# fidelidad. NUNCA poner la API key en el frontend ni en git.
#
# Contrato del cliente (backend/app/services/assistant_service.py):
#   POST {FREELLMAPI_BASE_URL}/chat/completions
#   Authorization: Bearer {FREELLMAPI_API_KEY}
#   Body: {"messages": [{"role": "user", "content": "..."}], "model": "auto"}
#
# OJO (precedencia): docker-compose usa este archivo como `env_file`, así
# que estas variables PISAN las de backend/.env (pydantic-settings prioriza
# el entorno sobre el archivo .env). Mantén AMBOS bloques alineados o el
# backend hablará con el servicio equivocado (401 "Incorrect API key").
#
# Despliegue actual: proxy self-hosted en la red docker `freellmapi_default`.
FREELLMAPI_ENABLED=false
FREELLMAPI_API_KEY=
# URL base OpenAI-compatible (termina en /v1; el cliente añade /chat/completions).
FREELLMAPI_BASE_URL=http://freellmapi-freellmapi-1:3001/v1
# "auto" deja que el proxy self-hosted elija. En apifreellm.com el alias es "apifreellm".
FREELLMAPI_MODEL=auto
# Timeout en segundos de cada llamada a la IA (evita bloquear el chat).
FREELLMAPI_TIMEOUT=30

# ----------------------------------------------------------
# Docker
# ----------------------------------------------------------
DOCKER_ENV=true

# ----------------------------------------------------------
# Validación de arranque del contenedor (backend/entrypoint.sh)
# ----------------------------------------------------------
# true  -> el arranque ABORTA si:
#            - FREELLMAPI_ENABLED=true sin FREELLMAPI_API_KEY
#            - GOOGLE_WALLET_ENABLED=true sin credenciales válidas
#            - el esquema no tiene historial de Alembic o presenta drift
# false -> degrada esos abortes a advertencias (SOLO para reparaciones
#          puntuales; la app puede fallar en runtime). Por defecto: true.
STARTUP_VALIDATION_STRICT=true
